{
  "name": "vektorprogrammet",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && effect-tsgo patch --typescript --oxlint",
    "ready": "vp check && bun run check:exceptions && bun run check:store-boundary && bun run check:module-graph && bun run check:docs && bun run test:all && bun run knip && bun run cpd && bun run secrets && vp -C apps/web build",
    "test:all": "vp run -r --no-cache test",
    "docs": "bun run --cwd tools/docgen generate",
    "check:docs": "bun run --cwd tools/docgen generate --check",
    "description": "bun run --cwd tools/effx-conformance generate",
    "description:regenerate": "bun run --cwd tools/effx-conformance regenerate",
    "description:drift": "bun run --cwd tools/effx-conformance drift",
    "check:exceptions": "bun tools/quality/checkEffectExceptions.ts",
    "check:store-boundary": "bun tools/quality/checkStoreBoundary.ts",
    "check:module-graph": "bun tools/quality/checkModuleGraph.ts",
    "sync:effect-policy": "bun tools/quality/syncEffectPolicy.ts",
    "knip": "knip",
    "cpd": "jscpd --config .jscpd.json apps packages tools",
    "secrets": "gitleaks git --config .gitleaks.toml --redact",
    "dev": "vp run @vektorprogrammet/web#dev",
    "prototype:setup": "bash tools/prototype/setup.sh",
    "prototype:dev": "bash tools/prototype/with-env.sh bunx vp -C apps/web dev --port 3000",
    "e2e": "bun run --cwd apps/web e2e",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/tsgo": "0.53.1",
    "@phibkro/oxlint-effect-plugin": "0.2.0",
    "@shadcn/lint": "0.2.1",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxc-parser": "catalog:",
    "oxlint-plugin-complexity": "4.0.0",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@effect/sql-d1": "4.0.6",
    "@effect/sql-sqlite-do": "4.0.6",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "typescript": "7.0.2",
    "@types/node": "^26.6.5",
    "effect": "4.0.6",
    "@effect/sql-pg": "4.0.6",
    "@effect/sql-pglite": "4.0.6",
    "@effect/sql-mysql2": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@electric-sql/pglite": "0.5.10",
    "drizzle-orm": "1.0.0-rc.5",
    "drizzle-kit": "1.0.0-rc.5",
    "@tanstack/react-start": "1.169.2",
    "@tanstack/react-router": "1.170.44",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "@types/sanitize-html": "2.16.2",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "oxc-parser": "0.153.0",
    "oxc-resolver": "11.24.2",
    "alchemy": "2.0.0-beta.83",
    "@effect/platform-bun": "4.0.6",
    "happy-dom": "20.14.6",
    "bcryptjs": "3.0.3",
    "@playwright/test": "1.63.0",
    "htmlparser2": "12.0.0",
    "domhandler": "6.0.1",
    "wrangler": "4.151.0"
  }
}
