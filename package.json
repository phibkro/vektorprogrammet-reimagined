    "packageManager": {
      "name": "bun",
      "version": "^1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "typescript": "7.0.2",
    "@types/node": "^26.6.5",
    "effect": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@effect/sql-pglite": "4.0.5",
    "@effect/sql-mysql2": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@electric-sql/pglite": "0.5.10",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "@tanstack/react-start": "1.169.2",
    "@tanstack/react-router": "1.170.44",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "@types/sanitize-html": "2.16.2",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "alchemy": "2.0.0-beta.83"
  }
