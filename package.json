{
  "name": "vektorprogrammet",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && effect-tsgo patch --typescript --oxlint",
    "ready": "vp check && bun run check:exceptions && bun run check:docs && vp run -r test && bun run knip && bun run cpd && bun run secrets && vp -C apps/web build && bun run check:cms",
    "docs": "bun run --cwd tools/docgen generate",
    "check:docs": "bun run --cwd tools/docgen generate --check",
    "check:cms": "bun run --cwd apps/cms check:bundle",
    "check:exceptions": "bun tools/quality/checkEffectExceptions.ts",
    "sync:effect-policy": "bun tools/quality/syncEffectPolicy.ts",
    "knip": "knip",
    "cpd": "jscpd --config .jscpd.json apps packages tools",
    "secrets": "gitleaks git --config .gitleaks.toml --redact",
    "dev": "vp run @vektorprogrammet/web#dev",
    "e2e": "bun run --cwd apps/web e2e",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/tsgo": "0.53.1",
    "@phibkro/oxlint-effect-plugin": "0.2.0",
    "@shadcn/lint": "0.2.1",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxc-parser": "catalog:",
    "oxlint-plugin-complexity": "4.0.0",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "typescript": "7.0.2",
    "@types/node": "^26.6.5",
    "effect": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@effect/sql-pglite": "4.0.5",
    "@effect/sql-mysql2": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@electric-sql/pglite": "0.5.10",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "@tanstack/react-start": "1.169.2",
    "@tanstack/react-router": "1.170.44",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "@types/sanitize-html": "2.16.2",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "oxc-parser": "0.153.0",
    "alchemy": "2.0.0-beta.83",
    "@effect/platform-bun": "4.0.5",
    "bcryptjs": "3.0.3",
    "@playwright/test": "1.63.0",
    "astro": "7.4.0",
    "@astrojs/react": "7.1.0",
    "@astrojs/cloudflare": "14.4.0",
    "emdash": "1.3.0",
    "@emdash-cms/cloudflare": "1.3.0",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.83",
    "pg": "8.23.1",
    "@effect/openapi-generator": "4.0.5",
    "htmlparser2": "12.0.0",
    "domhandler": "6.0.1",
    "miniflare": "5.20261012.0-beta"
  }
}
