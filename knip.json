{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**"],
  "workspaces": {
    "tools/quality": {
      "entry": ["checkEffectExceptions.ts"],
      "project": ["*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/server/**",
        "src/functions/**",
        "src/components/ui/**",
        "src/server.ts",
        "src/router.tsx",
        "src/start.ts",
        "alchemy.run.ts",
        "e2e/playwright.config.ts",
        "e2e/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "e2e/**/*.ts",
        "**/*.css"
      ]
    },
    "apps/cms": {
      "entry": ["src/live.config.ts"],
      "project": ["**/*.{ts,astro}"]
    },
    "packages/cms-client": {
      "ignore": ["src/generated.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/domain": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/db": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/import": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/docgen": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/db-path-spike": {
      "entry": ["src/worker.ts", "alchemy.run.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "*.ts"]
    }
  },
  "ignoreBinaries": ["devenv", "gitleaks", "psql"]
}
