{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**", ".agents/skills/**/*.map.mjs"],
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    "tools/quality": {
      "entry": [
        "checkEffectExceptions.ts",
        "checkModuleGraph.ts",
        "checkStoreBoundary.ts",
        "syncEffectPolicy.ts"
      ],
      "project": ["*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/server/**",
        "src/functions/**",
        "src/components/ui/**",
        "src/server.ts",
        "src/router.tsx",
        "src/start.ts",
        "e2e/playwright.config.ts",
        "e2e/**/*.spec.ts",
        "e2e/seedExtra.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "e2e/**/*.ts",
        "**/*.css"
      ]
    },
    "packages/domain": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/db": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/prototype": {
      "entry": ["seed.ts"],
      "project": ["*.ts"]
    },
    "tools/import": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/docgen": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/db-path-spike": {
      "entry": ["src/worker.ts", "alchemy.run.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "*.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks", "psql"]
}
