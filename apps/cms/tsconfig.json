{
  "extends": "../../tsconfig.json",
  "include": [
    "astro.config.ts",
    "build/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    ".astro/types.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "astro/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
