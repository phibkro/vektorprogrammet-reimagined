{
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "allowedUnstableApis": [
          "@effect/platform-bun/BunRuntime#runMain",
          "@effect/platform-bun/BunServices#layer",
          "@effect/platform-node/NodeRuntime#runMain",
          "@effect/platform-node/NodeServices#layer",
          "@effect/sql-mysql2/MysqlClient#MysqlClient",
          "@effect/sql-mysql2/MysqlClient#layer",
          "@effect/sql-pg/PgClient#PgClient",
          "@effect/sql-pg/PgClient#layer",
          "@effect/sql-pg/PgClient#make",
          "@effect/sql-pg/PgClient#TypeId",
          "@effect/sql-pglite/PgliteClient#layer",
          "@effect/vitest#it",
          "@effect/vitest#layer",
          "effect/Arbitrary",
          "effect/Crypto#Crypto",
          "effect/Crypto#make",
          "effect/FileSystem#FileSystem",
          "effect/Path#Path",
          "effect/cli/Command#make",
          "effect/cli/Command#run",
          "effect/cli/Command#withDescription",
          "effect/cli/Flag#Boolean",
          "effect/cli/Flag#String",
          "effect/cli/Flag#Directory",
          "effect/cli/Flag#withDefault",
          "effect/cli/Flag#withFallbackConfig",
          "effect/cli/Flag#withDescription",
          "effect/http-api/OpenApi#OpenAPISpec",
          "effect/http/FetchHttpClient#layer",
          "effect/http/Headers#get",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClient#filterStatusOk",
          "effect/http/HttpClient#make",
          "effect/http/HttpClient#mapRequest",
          "effect/http/HttpClient#retryTransient",
          "effect/http/HttpClientError#HttpClientError",
          "effect/http/HttpClientRequest#HttpClientRequest",
          "effect/http/HttpClientRequest#acceptJson",
          "effect/http/HttpClientRequest#bodyJsonUnsafe",
          "effect/http/HttpClientRequest#bodyUrlParams",
          "effect/http/HttpClientRequest#bearerToken",
          "effect/http/HttpClientRequest#get",
          "effect/http/HttpClientRequest#post",
          "effect/http/HttpClientRequest#prependUrl",
          "effect/http/HttpClientRequest#put",
          "effect/http/HttpClientResponse#HttpClientResponse",
          "effect/http/HttpClientResponse#filterStatusOk",
          "effect/http/HttpClientResponse#fromWeb",
          "effect/http/HttpClientResponse#schemaBodyJson",
          "effect/process/ChildProcess#make",
          "effect/process/ChildProcessSpawner#ChildProcessSpawner",
          "effect/process/ChildProcessSpawner#ExitCode",
          "effect/reactivity/Reactivity#layer",
          "effect/rpc",
          "effect/sql/SqlClient#SqlClient",
          "effect/sql/SqlError#SqlError",
          "effect/sql/SqlError#isSqlError",
          "effect/sql/SqlSchema#findOne"
        ],
        "diagnosticSeverity": {
          "abortControllerInEffect": "error",
          "acquireReleaseDisposable": "error",
          "allOfMapToForEach": "error",
          "asyncFunction": "error",
          "catchAllTagDispatchToCatchTag": "error",
          "catchAllToMapError": "error",
          "catchChainToFirstSuccessOf": "error",
          "catchConditionalRefailToCatchIf": "error",
          "catchDieToOrDie": "error",
          "catchIfTagToCatchTag": "error",
          "catchRefailToTapError": "error",
          "catchTagToCatchReason": "error",
          "catchToIgnore": "error",
          "catchToOrElseSucceed": "error",
          "catchUnfailableEffect": "error",
          "classSelfMismatch": "error",
          "duplicatePackage": "error",
          "effectFnIife": "error",
          "effectFnImplicitAny": "error",
          "effectFnOpportunity": "error",
          "effectGenUsesAdapter": "error",
          "effectInFailure": "error",
          "effectInVoidSuccess": "error",
          "effectMapFlatten": "error",
          "effectMapVoid": "error",
          "effectSleepZeroToYieldNow": "error",
          "effectSucceedWithVoid": "error",
          "errorPayloadShadowsName": "error",
          "experimentalApiUsage": "error",
          "extendsNativeError": "error",
          "flatMapConditionalToFilterOrFail": "error",
          "flatMapIgnoredParamToAndThen": "error",
          "flatMapToMap": "error",
          "flatMapToTap": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "genericEffectServices": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "instanceOfSchema": "error",
          "layerMergeAllWithDependencies": "error",
          "lazyEffect": "error",
          "lazyPromiseInEffectSync": "error",
          "leakingRequirements": "error",
          "mapSomeToAsSome": "error",
          "matchEffectToMapBoth": "error",
          "matchEffectToMatch": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "missingReturnYieldStar": "error",
          "missingStarInYieldEffectGen": "error",
          "multipleCatchTag": "error",
          "multipleEffectProvide": "error",
          "newPromise": "error",
          "nodeBuiltinImport": "error",
          "nonObjectEffectServiceType": "error",
          "obsoleteMatchImport": "error",
          "obsoleteSchemaImport": "error",
          "optionMatchToFromOption": "error",
          "outdatedApi": "error",
          "overriddenSchemaConstructor": "error",
          "preferEffectArray": "error",
          "preferEffectRecord": "error",
          "preferSchemaOverJson": "error",
          "preferSucceedSomeOrNone": "error",
          "preferTypedSchemaDecoder": "error",
          "preferUnsafeConstructor": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "promiseInEffectSuccess": "error",
          "provideLayerSucceedToProvideService": "error",
          "raceFirstWithSleepToTimeout": "error",
          "redundantMapError": "error",
          "redundantOrDie": "error",
          "redundantSchemaTagIdentifier": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "runOfExitToRunExit": "error",
          "schemaClassMissingBrand": "error",
          "schemaLiteralNonFinite": "error",
          "schemaNumber": "error",
          "schemaOpaqueInstanceMember": "error",
          "schemaStructWithTag": "error",
          "schemaSync": "error",
          "schemaSyncInEffect": "error",
          "scopeInLayerEffect": "error",
          "syncToSucceed": "error",
          "timeoutCatchTagToTimeoutOrElse": "error",
          "tryCatchInEffectGen": "error",
          "unknownInEffectCatch": "error",
          "unnecessaryEffectGen": "error",
          "unnecessaryFailYieldableError": "error",
          "unnecessaryPipe": "error",
          "unnecessaryPipeChain": "error",
          "unnecessaryTypeofType": "error",
          "unstableApiUsage": "error"
        }
      }
    ]
  },
  "include": [
    "vite.config.ts",
    "commitlint.config.ts",
    "tools/oxlint/**/*.ts",
    "tools/quality/**/*.ts"
  ]
}
