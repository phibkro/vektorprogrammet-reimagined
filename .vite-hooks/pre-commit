#!/bin/sh
# Hooks run inside devenv so Bun, gitleaks, and the pinned Node runtime are available.
# Re-enter the project's shell for GUI/editor commits that did not inherit direnv.
set -eu
if [ -z "${DEVENV_ROOT:-}" ]; then
  exec devenv shell -- sh "$0" "$@"
fi
# Scan the staged blobs before lint-fix can touch them.
gitleaks git --staged --redact --no-banner --config .gitleaks.toml
bunx vp staged
