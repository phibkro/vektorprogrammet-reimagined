#!/bin/sh
# Run the complete workspace test task graph against devenv's local PostgreSQL/MySQL.
set -eu
if [ -z "${DEVENV_ROOT:-}" ]; then
  exec devenv shell -- sh "$0" "$@"
fi
# Package scripts re-enter devenv; serialize them to prevent concurrent cleanup of .devenv/load-exports.
bunx vp run -r --concurrency-limit 1 test
