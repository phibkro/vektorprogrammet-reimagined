{
  "name": "@vektorprogrammet/db-path-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bunx vp test",
    "check": "vp check",
    "cf": "DO_NOT_TRACK=1 cf",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "deploy": "alchemy deploy alchemy.run.ts --stage spike --profile production",
    "smoke": "bun src/smoke.ts",
    "teardown": "alchemy destroy alchemy.run.ts --stage spike --profile production --yes && psql \"$DATABASE_URL\" -X -v ON_ERROR_STOP=1 -c 'drop schema if exists spike_0000 cascade' -c 'drop table if exists public.spike_0000_migrations'"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@vektorprogrammet/db": "workspace:*",
    "@vektorprogrammet/domain": "workspace:*",
    "bcryptjs": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "cf": "1.0.0-beta.12",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
