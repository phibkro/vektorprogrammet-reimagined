  "paths": {
    "/_emdash/api/content/{collection}": {
      "get": {
        "operationId": "listContent",
        "summary": "List content items",
        "description": "Returns a paginated list of content items in the specified collection.",
        "tags": [
          "Content"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "collection",
            "schema": {
              "type": "string",
              "description": "Collection slug",
              "examples": [
                "posts"
              ]
            },
            "required": true,
            "description": "Collection slug"
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor for pagination",
              "type": "string",
              "maxLength": 2048
            },
            "description": "Opaque cursor for pagination"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "Maximum number of items to return (1-100, default 50)",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "description": "Maximum number of items to return (1-100, default 50)"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "description": "1-based page number, for numbered pages instead of a cursor",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "description": "1-based page number, for numbered pages instead of a cursor"
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "published",
                "scheduled",
                "archived",
                "pending",
                "private",
                "future",
                "all"
              ]
            }
          },
          {
            "in": "query",
            "name": "orderBy",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "in": "query",
            "name": "locale",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "authorId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          {
            "in": "query",
            "name": "dateField",
