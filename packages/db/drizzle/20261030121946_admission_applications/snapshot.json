      "row": {
        "schema": "public",
        "table": "application",
        "name": "application_special_needs",
        "value": "(\"special_needs\" is null and \"special_needs_consent_version\" is null and \"special_needs_consented_at\" is null) or (\"special_needs\" is not null and length(\"special_needs\") between 1 and 1000 and \"special_needs_consent_version\" is not null and \"special_needs_consented_at\" is not null)",
