{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 5am on the first day of the month"],
  "timezone": "Europe/Oslo",
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchPackageNames": ["effect", "@effect/**"],
      "groupName": "Effect packages"
    },
    {
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"],
      "groupName": "Drizzle ORM and Kit"
    },
    {
      "matchPackageNames": ["vite-plus"],
      "groupName": "Vite+ toolchain"
    },
    {
      "description": "The browser binaries come from nixpkgs (playwright-driver in devenv.lock). A different Playwright version cannot launch them. Move all three together with the nixpkgs pin, by hand.",
      "matchPackageNames": [
        "@playwright/test",
        "playwright",
        "playwright-core"
      ],
      "enabled": false
    }
  ]
}
