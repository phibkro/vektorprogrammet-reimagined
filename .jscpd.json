{
  "minTokens": 40,
  "threshold": 0,
  "format": ["typescript"],
  "reporters": ["console"],
  "ignorePattern": [
    "(?m)^[\\t ]*import[\\t ]+(?:type[\\t ]+)?[\\w\\s{},*$]+[\\t ]+from[\\t ]+[\"'][^\"'\\n]+[\"'];"
  ],
  "ignore": [
    "apps/web/src/components/ui/**",
    "**/routeTree.gen.ts",
    "apps/web/drizzle/**",
    "tools/db-path-spike/drizzle/**",
    "tools/oxlint/anti-slop/**"
  ]
}
